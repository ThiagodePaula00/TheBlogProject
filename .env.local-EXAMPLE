# Atraso simulado nas consultas, em milissegundos (0 desativa)
SIMULATE_WAIT_IN_MS=0

# Tamanho máximo dos uploads de imagem, em bytes
NEXT_PUBLIC_IMAGE_UPLOAD_MAX_SIZE=921600

# Nome simples do diretório dentro de public/ onde as imagens são salvas
IMAGE_UPLOAD_DIRECTORY=uploads

# Chave aleatória usada para assinar tokens JWT (gere com: openssl rand -base64 32)
JWT_SECRET_KEY='SUA_CHAVE_SECRETA_AQUI'

# Validade da sessão de login; mantenha os dois valores correspondentes
# Exemplos: 3600 e '1h', 600 e '10m', 86400 e '1d'
LOGIN_EXPIRATION_SECONDS=86400
LOGIN_EXPIRATION_STRING='1d'

# Nome do cookie de sessão
LOGIN_COOKIE_NAME='loginSession'

# Credenciais usadas em /admin/login
LOGIN_USER='SEU_USUARIO_AQUI'
# Gere o hash com: npm run hash-password
LOGIN_PASS='SEU_HASH_DE_SENHA_AQUI'

# Habilita o login (0 = desabilitado, 1 = habilitado)
ALLOW_LOGIN=1